---
const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: 'Home' },
  { href: `${base}research/`, label: 'Research' },
  { href: `${base}campaigns/`, label: 'Campaigns' },
  { href: `${base}projects/`, label: 'Projects' },
  { href: `${base}publications/`, label: 'Publications' },
  { href: `${base}gallery/`, label: 'Gallery' },
];
---
<header>
  <div class="cover-banner">
    <div class="cover-inner">
      <nav class="site-nav cover-nav" id="site-nav">
        {links.map(l => <a href={l.href}>{l.label}</a>)}
      </nav>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="frame profile-row">
    <div class="avatar"></div>
    <div class="profile-text">
      <h1 style="font-size: 2.3rem;">Vivek Shah</h1>
      <p class="dek" style="margin-top: 2px;">Aerospace/Aeronautical Engineer &middot; Applied Math PhD Student</p>
    </div>
  </div>

  <div class="horizon"></div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = nav?.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  document.addEventListener('click', (e) => {
    if (!nav?.classList.contains('nav-open')) return;
    const target = e.target as Node;
    if (!nav.contains(target) && !toggle?.contains(target)) {
      nav.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>