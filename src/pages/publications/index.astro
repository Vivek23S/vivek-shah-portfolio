---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Publications & CV">
  <section class="frame tight" style="padding-top: var(--sp-5);">
    <div class="grid-margin">
      <div class="eyebrow">Publications</div>
      <div>
        <h1 class="page-title">Publications &amp; CV</h1>

        <div style="margin-top: var(--sp-3);">
          <h3>Effects of vehicle inertia on model-based wind estimation for multirotor sUASs</h3>
          <p class="eyebrow" style="margin-top: var(--sp-1);">AIAA SciTech Forum, 2027 &middot; accepted</p>
          <p class="dek" style="margin-top: var(--sp-2); max-width: 540px;">
            Investigates the tradeoff between slower dynamic response and increased drag
            sensitivity as multirotor mass increases, using SITL simulation, wind tunnel
            testing, and flight validation.
          </p>
        </div>

        <div class="rule-sm"></div>

        <h3>CV</h3>
        <p style="margin-top: var(--sp-2);">
          <a href={`${base}cv-vivek-shah.pdf`}>Download the latest CV (PDF) &rarr;</a>
        </p>
        <p class="eyebrow" style="margin-top: var(--sp-1);">
          Drop your current CV into <code>public/cv-vivek-shah.pdf</code> and this link
          will work as-is.
        </p>
      </div>
    </div>
  </section>
</Base>
